# =============================================================================
# AIROVE — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/airove?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/airove?sslmode=require"

# ── Redis (Upstash) ─────────────────────────────────────────────────────────
REDIS_URL="redis://default:xxx@xxx.upstash.io:6379"

# ── Authentication (Better Auth) ────────────────────────────────────────────
BETTER_AUTH_SECRET="generate-a-random-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# ── Object Storage (Cloudflare R2) ──────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="airove-production"
R2_PUBLIC_URL=""

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL="debug"

# ── Additional Configuration ────────────────────────────────────────────────
# AI Provider Settings
AIPROVIDER_API_URL="https://api.airo.be"
AIPROVIDER_SECRET="generate-secret-here"
# Analytics
GOOGLE_ANALYTICS_PROPERTY="G-XXXXXXXXXX"

